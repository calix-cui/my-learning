{
  "name": "product-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "简易商品管理网站后台前端（Vue 3 + TypeScript + Vite + Element Plus）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "type-check": "vue-tsc --noEmit",
    "acceptance": "node scripts/acceptance.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"scripts/*.mjs\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"scripts/*.mjs\" \"*.ts\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^23.11.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@12.10.1"
}
