# docker compose 使用的部署变量，复制成 .env 后改密码（.env 已被 .gitignore 忽略）
# 生产环境请换成强密码，不要用这里的示例值

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=fastapi_demo
MYSQL_USER=fastapi
MYSQL_PASSWORD=change-me-app

# --- 端口 ---
FRONTEND_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# --- 反向代理 ---
# localhost 会签本地自签名证书；填真实域名则由 Caddy 自动申请证书
SITE_ADDRESS=localhost
