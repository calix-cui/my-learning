# docker compose 使用的部署变量，复制成 .env 后改密码（.env 已被 .gitignore 忽略）
# 生产环境请换成强密码，不要用这里的示例值

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=fastapi_demo
MYSQL_USER=fastapi
MYSQL_PASSWORD=change-me-app

# --- 端口 ---
FRONTEND_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# --- 反向代理 ---
# localhost 会签本地自签名证书；填真实域名则由 Caddy 自动申请证书
SITE_ADDRESS=localhost

# --- 模型接入（后端读取）---
# 默认 fake：不联网、不需要 key。接真实模型时改成 openai 并填 base_url / key / model。
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# 改完 `docker compose up -d backend` 让容器读到新环境变量（.env 不进版本库）
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
