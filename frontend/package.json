{
  "name": "my-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "My Agent 应用前端（Vue 3 + TypeScript + Vite + Element Plus）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"scripts/*.mjs\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"scripts/*.mjs\" \"*.ts\"",
    "acceptance:chat": "node scripts/chat-acceptance.mjs",
    "acceptance:auth": "node scripts/auth-acceptance.mjs",
    "acceptance:settings": "node scripts/settings-acceptance.mjs",
    "acceptance:agent": "node scripts/agent-acceptance.mjs",
    "acceptance:tools": "node scripts/tools-acceptance.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.7.9",
    "dompurify": "^3.4.17",
    "element-plus": "^2.9.1",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "puppeteer-core": "^23.11.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.7",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@12.10.1"
}
