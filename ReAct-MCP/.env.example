# 复制为 .env 后填写；.env 已被根 .gitignore 忽略，不要提交真实密钥。

# OpenAI 兼容服务（base_url 可指向本地或第三方网关）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# MCP server 列表：JSON 数组，command/args 用于启动 stdio server
MCP_SERVERS=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."]}]
