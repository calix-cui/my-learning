# 环境变量模板：复制成 .env 后填入本地真实值，.env 已被 .gitignore 忽略
#   cp .env.example .env
#
# DATABASE_URL 是 app/config.py 里 Settings 的必填字段（没有默认值），
# 缺少它时导入 app 会直接抛 pydantic 校验错误，因此新环境第一步就是准备这个文件。
#
# 格式：mysql+pymysql://<用户名>:<密码>@<主机>:<端口>/<数据库名>?charset=utf8mb4
# 数据库本体需要先手动创建（create_all 只建表，不建库）：
#   mysql -u root -p -e "CREATE DATABASE fastapi_demo DEFAULT CHARSET utf8mb4;"
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/fastapi_demo?charset=utf8mb4

# ---- 模型接入（阶段 4）----
# 默认 fake：不联网、不需要 key，回复形如「[fake] 收到：你的话」，用于本地开发与 CI。
# 要用真实模型就改成 openai，并填下面三项（任一留空会在启动时报错，而不是等到第一次请求）。
#   deepseek:  LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#   openai:    LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# 注意：LLM_API_KEY 只放在 .env（已被 .gitignore 忽略），不要写进代码或镜像。
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# 假模型每块延迟（秒）：想看逐字效果就设 0.05，测试里保持 0
LLM_FAKE_DELAY_SECONDS=0
